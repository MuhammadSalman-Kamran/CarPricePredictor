{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "typography": {
      "fontFamilies": [
        { "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, \"Apple Color Emoji\", \"Segoe UI Emoji\"", "name": "Inter", "slug": "inter" },
        { "fontFamily": "Roboto Slab, Inter, serif", "name": "Roboto Slab", "slug": "roboto-slab" }
      ],
      "fluid": true
    },
    "layout": { "contentSize": "1140px", "wideSize": "1440px" },
    "spacing": { "units": ["px","em","rem","vh","vw","%"] },
    "custom": {
      "spacing": { "container": "max-w-7xl" }
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)"
    }
  }
}