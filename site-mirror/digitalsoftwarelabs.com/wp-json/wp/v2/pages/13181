s Section<\/title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    body {\n      font-family: 'Poppins', sans-serif;\n      \/*margin: 0;*\/\n      \/*background: #f9f9f9;*\/\n    }\n\n    .tabs-container {\n      padding: 40px 20px;\n      overflow: hidden !important;\n    }\n\n    .progress-nav {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: -85px;\n      position: relative;\n      max-width: 1200px;\n      margin-inline: auto;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      padding-bottom: 20px;\n    }\n\n    .progress-nav::before {\n      content: '';\n      position: absolute;\n      top: 60%;\n      left: 80px;\n      right: 80px;\n      height: 4px;\n      background: #eee;\n      z-index: 1;\n    }\n\n    .step {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      position: relative;\n      z-index: 2;\n      flex: 0 0 auto;\n      width: 100px;\n      scroll-snap-align: center;\n      cursor: pointer;\n    }\n\n    .step span {\n      margin-bottom: 10px;\n      font-size: 14px;\n      color: #ccc;\n      white-space: nowrap;\n      text-align: center;\n    }\n\n    .circle {\n      width: 70px;\n      height: 70px;\n      border-radius: 50%;\n      background: #fff;\n      border: 6px solid #eee;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: bold;\n      font-size: 20px;\n      color: #1c1c6b;\n    }\n\n    .step.active .circle {\n      background: #1c1c6b;\n      color: #fff;\n      border-color: #1c1c6b;\n    }\n\n    .step.active span {\n      color: #1c1c6b;\n    }\n\n    .tab-content {\n      background: white;\n      padding: 6rem 3rem 4rem;\n      border-radius: 15px;\n      box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);\n      max-width: 1250px;\n      margin: 0 auto;\n      margin-top: 30px