content-timeline-block\">\n    <div class=\"eael-content-timeline-line\">\n        <div class=\"eael-content-timeline-inner\"><\/div>\n    <\/div>\n    <div class=\"eael-content-timeline-img eael-picture \"><\/div><div class=\"eael-content-timeline-content\"><h2 class=\"eael-timeline-title\"><a href=\"\">Legacy Front-End Modernization<\/a><\/h2><p><span style=\"font-weight: 400\">We upgrade outdated interfaces into modern, efficient front-ends with improved performance, cleaner code, and compatibility with today\u2019s devices and browsers.<\/span><\/p><span class=\"eael-date\"><\/span><\/div><\/div>\t\t\t\t<\/div>\n\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section data-particle_enable=\"false\" data-particle-mobile-disabled=\"false\" class=\"elementor-section elementor-top-section elementor-element elementor-element-6e5f9e5 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"6e5f9e5\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-no\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-902b31f\" data-id=\"902b31f\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section data-particle_enable=\"false\" data-particle-mobile-disabled=\"false\" class=\"elementor-section elementor-inner-section elementor-element elementor-element-d1ec925 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-id=\"d1ec925\" data-element_type=\"section\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-default\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-inner-column elementor-element elementor-element-62ee2e4\" data-id=\"62ee2e4\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-6cceefb elementor-widget elementor-widget-heading\" data-id=\"6cceefb\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Our Front End Development Process\n<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5f44c0a elementor-widget elementor-widget-text-editor\" data-id=\"5f44c0a\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-weight: 400;\">Transform your ideas into high-performing digital experiences. Our front-end process delivers sleek, responsive, and scalable interfaces. Let\u2019s create a user experience that drives engagement and growth. Start your project with us today.<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<div class=\"elementor-element elementor-element-9a92d15 elementor-widget elementor-widget-html\" data-id=\"9a92d15\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" \/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\/>\n  <title>Tab Layout<\/title>\n  <style>\n    @import url('https:\/\/fonts.googleapis.com\/css2?family=Poppins:wght@400;600&display=swap');\n\n    .container {\n      display: flex;\n      padding: 0px;\n      box-sizing: border-box;\n      gap: 10px;\n      flex-wrap: wrap;\n      width: 100vw;\n    }\n\n    .tabs, .side-tabs {\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n      flex: 2 2 100px;\n      min-width: 150px;\n    }\n\n    .tab {\n      border: 1px solid #ccc;\n      padding: 50px;\n      background: white;\n      text-align: center;\n      border-radius: 10px;\n      cursor: pointer;\n      transition: 0.3s;\n      font-weight: 600;\n      font-size: 14px;\n    }\n\n    .tab img {\n      width: 70px;\n      margin-bottom: 10px;\n      transition: 0.3s;\n    }\n\n    .tab.active, .tab:hover {\n      background: #3f51f6;\n      color: white;\n      border: none;\n    }\n\n    .content {\n      flex: 6 6;\n      background: linear-gradient(to right, #eaf6ff, #f9fbff);\n      border: 1px solid #ccc;\n      border-radius: 10px;\n      padding: 5rem;\n      display: flex;\n      flex-direction: column;\n      align-items: start;\n      justify-content: center;\n      text-align: start;\n      min-width: 360px;\n    }\n\n    .content img {\n      width: 80px;\n      margin-bottom: 15px;\n    }\n\n    .content h1 {\n      font-size: 50px;\n      margin: 10px 0;\n      width: 100%;\n      font-weight: 700;\n    }\n\n    .content p {\n      font-size: 15px;\n      color: #333;\n      line-height: 1.6;\n      max-width: 100%;\n    }\n\n    .content small {\n      font-size: 0px;\n      color: #666;\n    }\n\n    @media (max-width: 768px) {\n      .container {\n        flex-direction: column;\n      }\n\n      .tabs, .side-tabs {\n        flex-direction: row;\n        flex-wrap: wrap;\n        justify-content: center;\n      }\n\n      .tab {\n        flex: 1 1 120px;\n        font-size: 12px;\n        padding: 15px 8px;\n      }\n\n      .tab img {\n        width: 35px;\n      }\n\n      .content {\n        padding: 20px 15px;\n      }\n\n      .content h1 {\n        font-size: 20px;\n      }\n\n      .content p {\n        font-size: 14px;\n      }\n    }\n  <\/style>\n<\/head>\n<body>\n  <div class=\"container\">\n    <div class=\"tabs\" id=\"leftTabs\">\n      <div class=\"tab active\" data-index=\"0\">\n        <img decoding=\"async\" src=\"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-636.png\" alt=\"Icon\">\n        <div>Wireframing<br>and Design<\/div>\n      <\/div>\n      <div class=\"tab\" data-index=\"1\">\n        <img decoding=\"async\" src=\"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-637.png\" alt=\"Icon\">\n        <div>Setup<br>CI\/CD Pipeline<\/div>\n      <\/div>\n      <div class=\"tab\" data-index=\"2\">\n        <img decoding=\"async\" src=\"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-637.png\" alt=\"Icon\">\n        <div>UI<br>Development<\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"content\" id=\"tabContent\">\n      <img decoding=\"async\" src=\"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-636.png\" alt=\"Icon\">\n      <h1>Wireframing and Design<\/h1>\n      <p>\n        We begin by mapping out the interface through strategic wireframes and engaging designs that serve both form and function. This stage allows us to visualize your ideas while keeping user behavior and journey in focus. Every wireframe is crafted to simplify navigation, define layout logic, and align with your brand\u2019s tone and goals. Our design team ensures that the final layout is intuitive, accessible, and optimized for responsiveness across all screen sizes and platforms before development begins.\n      <\/p>\n    <\/div>\n\n    <div class=\"side-tabs\" id=\"rightTabs\">\n      <div class=\"tab\" data-index=\"3\">\n        <img decoding=\"async\" src=\"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-637.png\" alt=\"Icon\">\n        <div>Connect<br>Backend<\/div>\n      <\/div>\n      <div class=\"tab\" data-index=\"4\">\n        <img decoding=\"async\" src=\"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-637.png\" alt=\"Icon\">\n        <div>Performance<br>Optimization<\/div>\n      <\/div>\n      <div class=\"tab\" data-index=\"5\">\n        <img decoding=\"async\" src=\"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-637.png\" alt=\"Icon\">\n        <div>Cross-Browser<br>Testing<\/div>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <script>\n    const tabs = document.querySelectorAll('.tab');\n    const content = document.getElementById('tabContent');\n\n    const activeIcon = \"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-636.png\";\n    const inactiveIcon = \"https:\/\/digitalsoftwarelabs.com\/wp-content\/uploads\/2025\/05\/Group-637.png\";\n\n    const tabContents = [\n      {\n        title: \"Wireframing and Design\",\n        text: `We begin by mapping out the interface through strategic wireframes and engaging designs that serve both form and function. This stage allows us to visualize your ideas while keeping user behavior and journey in focus. Every wireframe is crafted to simplify navigation, define layout logic, and align with your brand\u2019s tone and goals. Our design team ensures that the final layout is intuitive, accessible, and optimized for responsiveness across all screen sizes and platforms before development begins.`\n      },\n      {\n        title: \"Setup CI\/CD Pipeline\",\n        text: `To ensure faster releases and fewer deployment issues, we implement a reliable CI\/CD (Continuous Integration\/Continuous Deployment) pipeline. This automates testing, integration, and delivery, minimizing manual errors and keeping your front-end updates streamlined. Our pipeline setup supports quick rollouts of new features while maintaining code integrity and performance. It also helps in early bug detection, seamless collaboration, and consistent deployment environments, resulting in faster project timelines and better end-user experience.`\n      },\n      {\n        title: \"UI Development\",\n        text: `Our UI development process focuses on building clean, modular, and reusable components using modern frameworks like React, Angular, or Vue. We prioritize performance, accessibility, and responsiveness throughout the build. The interfaces we develop are scalable, maintainable, and tailored to meet user expectations. By following a component-based architecture, we reduce code duplication, speed up updates, and ensure consistency in design and functionality. Every element is optimized for usability and smooth interaction on all devices.`\n      },\n      {\n        title: \"Connect Backend\",\n        text: `We ensure effective interaction between the user interface and your backend systems through secure API integration. Whether it's REST or GraphQL, our developers connect the front-end to backend services for real-time content updates, user authentication, and dynamic data rendering. This connection empowers users with interactive features and ensures that the application runs smoothly under varying load conditions. To support this, we implement scalable, high-performance backend development strategies, ensuring reliable data flow, advanced functionality, and a flexible foundation for future expansion and third-party integrations.`\n      },\n      {\n        title: \"Performance Optimization\",\n        text: `A slow front end can cost you users. That\u2019s why we apply best practices for performance optimization right from the start. Our process includes lazy loading, code splitting, asset minification, caching strategies, and image optimization. These methods reduce initial load times, ensure quicker page transitions, and offer a better mobile experience. We use tools like Lighthouse and WebPageTest to identify bottlenecks and continuously fine-tune performance to meet both SEO standards and user expectations.`\n      },\n      {\n        title: \"Cross-Browser and Cross-Device Testing\",\n        text: `To guarantee a consistent experience, we thoroughly test your front end across all major browsers (Chrome, Safari, Firefox, Edge) and devices (mobile, tablet, desktop). Our testing process identifies layout shifts, compatibility issues, and performance lags, allowing us to fix them before deployment. By reflecting real-world usage and mobile development standards, we ensure everything works flawlessly, from touch gestures on mobile devices to keyboard navigation on desktops. The result is a seamless, accessible interface that performs reliably no matter where or how it's accessed.`\n      }\n    ];\n\n    tabs.forEach((tab, index) => {\n      tab.addEventListener('mouseenter', () => {\n        tabs.forEach(t => {\n          t.classList.remove('active');\n          t.querySelector('img').src = inactiveIcon;\n        });\n\n        tab.classList.add('active');\n        tab.querySelector('img').src = activeIcon;\n\n        const data = tabContents[index];\n        content.innerHTML = `\n          <img decoding=\"async\" src=\"${activeIcon}\" alt=\"Icon\">\n          <small>${data.location || ''}<\/small>\n          <h1>${data.title}<\/h1>\n          <p>${data.text}<\/p>\n        `;\n      });\n    });\n\n    window.addEventListener('load', () => {\n      const firstTab = document.querySelector('.tab[data-index=\"0\"]');\n      if (firstTab) {\n        firstTab.classList.add('active');\n        firstTab.querySelector('img').src = activeIcon;\n      }\n    });\n  <\/script>\n<\/body>\n<\/html>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section data-particle_enable=\"false\" data-particle-mobile-disabled=\"false\" class=\"elementor-section elementor-top-section elementor-element elementor-element-b9f6bca elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"b9f6bca\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap