t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<div class=\"elementor-element elementor-element-8ba4c49 elementor-widget elementor-widget-html\" data-id=\"8ba4c49\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Responsive Tabs Section<\/title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <style>\n    body {\n      font-family: 'Poppins', sans-serif;\n      \/*margin: 0;*\/\n      \/*background: #f9f9f9;*\/\n    }\n\n    .tabs-container {\n      padding: 40px 20px;\n    }\n\n    .progress-nav {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-bottom: -85px;\n      position: relative;\n      max-width: 1200px;\n      margin-inline: auto;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      padding-bottom: 20px;\n    }\n\n    .progress-nav::before {\n      content: '';\n      position: absolute;\n      top: 60%;\n      left: 80px;\n      right: 80px;\n      height: 4px;\n      background: #eee;\n      z-index: 1;\n    }\n\n    .step {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      position: relative;\n      z-index: 2;\n      flex: 0 0 auto;\n      width: 100px;\n      scroll-snap-align: center;\n      cursor: pointer;\n    }\n\n    .step span {\n      margin-bottom: 10px;\n      font-size: 14px;\n      color: #ccc;\n      white-space: nowrap;\n      text-align: center;\n    }\n\n    .circle {\n      width: 70px;\n      height: 70px;\n      border-radius: 50%;\n      background: #fff;\n      border: 6px solid #eee;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: bold;\n      font-size: 20px;\n      color: #1c1c6b;\n    }\n\n    .step.active .circle {\n      background: #1c1c6b;\n      color: #fff;\n      border-color: #1c1c6b;\n    }\n\n    .step.active span {\n      color: #1c1c6b;\n    }\n\n    .tab-content {\n      background: white;\n      padding: 6rem 3rem 4rem;\n      border-radius: 15px;\n      box-shadow: 0 0 20px rgba(0, 0, 0, 0.05);\n      max-width: 1250px;\n      margin: 0 auto;\n      margin-top: 30px;\n    }\n\n    .tab-panel {\n      display: none;\n    }\n\n    .tab-panel.active {\n      display: block;\n    }\n\n    .tab-content h2 {\n      color: #0c0c55;\n      font-size: 32px;\n      margin-bottom: 20px;\n    }\n\n    .tab-content p {\n      font-size: 18px;\n      color: #333;\n      line-height: 1.7;\n    }\n\n    @media (max-width: 768px) {\n      .tab-content {\n        padding: 4rem 2rem;\n      }\n\n      .tab-content h2 {\n        font-size: 26px;\n      }\n\n      .tab-content p {\n        font-size: 16px;\n      }\n    }\n\n    @media (max-width: 480px) {\n      .circle {\n        width: 50px;\n        height: 50px;\n        font-size: 16px;\n        border-width: 4px;\n      }\n\n      .step {\n        width: 130px;\n      }\n\n      .tab-content {\n        padding: 3rem 1.5rem;\n      }\n      \n        .progress-nav{\n            margin-bottom: -75px;\n        }\n      \n    .progress-nav::before {\n      content: '';\n      position: absolute;\n      top: 60%;\n      left: 40px;\n      right: 80px;\n      height: 4px;\n      width: 1090px;\n      background: #eee;\n      z-index: 1;\n    }\n\n    }\n  <\/style>\n<\/head>\n<body>\n\n<div class=\"tabs-container\">\n  <div class=\"progress-nav\">\n    <div class=\"step active\" data-step=\"1\">\n      <span>Data<br>Visualization<\/span>\n      <div class=\"circle\">1<\/div>\n    <\/div>\n    <div class=\"step\" data-step=\"2\">\n      <span>Information<br>Architecture Design<\/span>\n      <div class=\"circle\">2<\/div>\n    <\/div>\n    <div class=\"step\" data-step=\"3\">\n      <span>Data-Driven<br>Design<\/span>\n      <div class=\"circle\">3<\/div>\n    <\/div>\n    <div class=\"step\" data-step=\"4\">\n      <span>Design<br>Sprint<\/span>\n      <div class=\"circle\">4<\/div>\n    <\/div>\n    <div class=\"step\" data-step=\"5\">\n      <span>Interaction<br>Design<\/span>\n      <div class=\"circle\">5<\/div>\n    <\/div>\n    <div class=\"step\" data-step=\"6\">\n      <span>UX Writing &<br>Content Strategy<\/span>\n      <div class=\"circle\">6<\/div>\n    <\/div>\n    <div class=\"step\" data-step=\"7\">\n      <span>UX<br>Research<\/span>\n      <div class=\"circle\">7<\/div>\n    <\/div>\n    <div class=\"step\" data-step=\"8\">\n  <span>User<br>Interface Design<\/span>\n  <div class=\"circle\">8<\/div>\n<\/div>\n<div class=\"step\" data-step=\"9\">\n  <span>Visual<br>Design<\/span>\n  <div class=\"circle\">9<\/div>\n<\/div>\n\n  <\/div>\n\n  <div class=\"tab-content\">\n    <div class=\"tab-panel active\" id=\"step-1\">\n      <h2>Data Visualization\n<\/h2>\n      <p>\n        We turn complex data into clear, interactive visuals that help users understand patterns and make informed decisions. As part of our UI UX design services, this approach supports smarter business outcomes and improves overall engagement across platforms through thoughtful, visual storytelling.\n      <\/p>\n    <\/div>\n    <div class=\"tab-panel\" id=\"step-2\">\n      <h2>Information Architecture Design<\/h2>\n      <p>Our UI\/UX design agency builds structured navigation and content systems that improve how users find information. By applying best practices in UX UI design, we make digital journeys smoother and more intuitive, ensuring users stay focused and satisfied throughout their experience by pairing thoughtful structure with reliable backend development that keeps everything running seamlessly behind the scenes.<\/p>\n    <\/div>\n    <div class=\"tab-panel\" id=\"step-3\">\n      <h2>Data-Driven Design<\/h2>\n      <p>By analyzing user behavior and analytics, we guide every design choice with real insights. Our UI UX design agency focuses on performance-driven design, blending creativity with logic to build smart, scalable solutions that reflect the core of what is UI\/UX design.<\/p>\n    <\/div>\n    <div class=\"tab-panel\" id=\"step-4\">\n      <h2>Design Sprint<\/h2>\n      <p>Through fast-paced design sprints, we validate ideas and solve problems with rapid feedback and prototypes. This agile method is part of our strategic UI UX design services, helping clients reduce risk and align design with user expectations from the start.<\/p>\n    <\/div>\n    <div class=\"tab-panel\" id=\"step-5\">\n      <h2>Interaction Design<\/h2>\n      <p>From micro-interactions to intuitive gestures, our team enhances usability through detailed UI\/UX design. These interactive elements guide users clearly and support engagement, naturally integrating with front-end development to ensure every visual detail functions smoothly. This approach reflects the latest UI\/UX design trends, making sure your product feels dynamic, modern, and user-friendly.<\/p>\n    <\/div>\n    <div class=\"tab-panel\" id=\"step-6\">\n      <h2>UX Writing & Content Strategy<\/h2>\n      <p>Clear, helpful language is key to good UI UX design. We develop user-focused content that matches your brand tone and guides interaction, helping people navigate confidently, an important part of what makes us the best UI UX design agency.<\/p>\n    <\/div>\n    <div class=\"tab-panel\" id=\"step-7\">\n      <h2>UX Research<\/h2>\n      <p>We conduct user interviews, testing, and journey mapping to understand your audience deeply. This research-driven process is essential to our UI UX design services, helping us design experiences that align with real user needs and stand out in the market.<\/p>\n    <\/div>\n    <div class=\"tab-panel\" id=\"step-8\">\n  <h2>User Interface Design<\/h2>\n  <p>\n    Our UI\/UX design agency combines usability and branding to deliver clean, functional interfaces. Every design element is intentional and focused on performance, visual consistency, and seamless interaction to support the overall goals of your product or platform.\n  <\/p>\n<\/div>\n<div class=\"tab-panel\" id=\"step-9\">\n  <h2>Visual Design<\/h2>\n  <p>\n    We craft modern, visually appealing products using typography, color systems, and layout principles. This attention to style and detail aligns with current UI\/UX design trends, elevating your product and reinforcing your identity through expert UX UI design.\n  <\/p>\n<\/div>\n\n  <\/div>\n<\/div>\n\n<script>\n  const steps = document.querySelectorAll('.step');\n  const panels = document.querySelectorAll('.tab-panel');\n\n  steps.forEach(step => {\n    step.addEventListener('click', () => {\n      steps.forEach(s => s.classList.remove('active'));\n      panels.forEach(p => p.classList.remove('active'));\n\n      step.classList.add('active');\n      const targetId = 'step-' + step.getAttribute('data-step');\n      document.getElementById(targetId).classList.add('active');\n    });\n  });\n<\/script>\n\n<\/body>\n<\/html>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<section data-particle_enable=\"false\" data-particle-mobile-disabled=\"false\" class=\"elementor-section elementor-top-section elementor-element elementor-element-adc081e elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"adc081e\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-no\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-408276a\" data-id=\"408276a\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<section data-particle_enable=\"false\" data-particle-mobile-disabled=\"false